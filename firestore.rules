rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function belongsToStore(storeId) {
      return signedIn() && storeId == '00756';
    }

    function validWasteEvent(storeId) {
      return request.resource.data.keys().hasOnly([
          'storeId', 'productId', 'productName', 'equivalentUnits', 'displayQuantity',
          'displayUnit', 'unitCostSnapshot', 'eventAt', 'dayKey', 'daypartId', 'menu',
          'deviceName', 'createdBy', 'createdByName'
        ])
        && request.resource.data.storeId == storeId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.productId is string
        && request.resource.data.productName is string
        && request.resource.data.equivalentUnits is number
        && request.resource.data.equivalentUnits != 0
        && request.resource.data.equivalentUnits >= -1000
        && request.resource.data.equivalentUnits <= 1000
        && request.resource.data.displayQuantity is number
        && request.resource.data.displayUnit in ['each', 'cup']
        && request.resource.data.unitCostSnapshot is number
        && request.resource.data.unitCostSnapshot >= 0
        && request.resource.data.eventAt is timestamp
        && request.resource.data.dayKey is string
        && request.resource.data.daypartId in ['breakfast', 'lunch', 'afternoon', 'early-dinner', 'late-dinner']
        && request.resource.data.menu in ['breakfast', 'lunch'];
    }

    function validDiscardEvent(storeId) {
      return request.resource.data.keys().hasOnly([
          'storeId', 'productId', 'productName', 'equivalentUnits', 'displayQuantity',
          'displayUnit', 'unitCostSnapshot', 'eventAt', 'dayKey', 'daypartId', 'menu',
          'deviceName', 'createdBy', 'createdByName', 'reason', 'reasonDetail'
        ])
        && request.resource.data.storeId == storeId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.productId is string
        && request.resource.data.productName is string
        && request.resource.data.equivalentUnits is number
        && request.resource.data.equivalentUnits != 0
        && request.resource.data.equivalentUnits >= -1000
        && request.resource.data.equivalentUnits <= 1000
        && request.resource.data.displayQuantity is number
        && request.resource.data.displayUnit in ['each', 'cup']
        && request.resource.data.unitCostSnapshot is number
        && request.resource.data.unitCostSnapshot >= 0
        && request.resource.data.eventAt is timestamp
        && request.resource.data.dayKey is string
        && request.resource.data.daypartId in ['breakfast', 'lunch', 'afternoon', 'early-dinner', 'late-dinner']
        && request.resource.data.menu in ['breakfast', 'lunch']
        && request.resource.data.reason in ['dropped', 'raw', 'overcooked', 'contaminated', 'quality', 'other']
        && request.resource.data.reasonDetail is string
        && request.resource.data.reasonDetail.size() <= 120;
    }

    function validSosEntry(storeId) {
      return request.resource.data.keys().hasOnly([
          'storeId', 'dayKey', 'daypartId', 'hourStart', 'averageSeconds', 'loggedAt',
          'createdBy', 'createdByName', 'deviceName'
        ])
        && request.resource.data.storeId == storeId
        && request.resource.data.createdBy == request.auth.uid
        && (
          (
            request.resource.data.keys().hasAll(['daypartId'])
            && request.resource.data.daypartId in ['breakfast', 'lunch', 'afternoon', 'early-dinner', 'late-dinner']
          )
          ||
          (
            request.resource.data.keys().hasAll(['hourStart'])
            && request.resource.data.hourStart is int
            && request.resource.data.hourStart >= 0
            && request.resource.data.hourStart <= 23
          )
        )
        && request.resource.data.averageSeconds is number
        && request.resource.data.averageSeconds >= 0
        && request.resource.data.averageSeconds <= 3600
        && request.resource.data.loggedAt is timestamp;
    }

    function validDonationRecord(storeId) {
      return request.resource.data.keys().hasOnly([
          'storeId', 'dayKey', 'actuals', 'predictions', 'units', 'variance', 'initials',
          'submittedAt', 'submittedBy', 'submittedByName', 'revision', 'confirmedZeroItemIds'
        ])
        && request.resource.data.storeId == storeId
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.initials is string
        && request.resource.data.initials.size() >= 2
        && request.resource.data.initials.size() <= 5
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && (!request.resource.data.keys().hasAny(['confirmedZeroItemIds'])
          || (request.resource.data.confirmedZeroItemIds is list
            && request.resource.data.confirmedZeroItemIds.size() <= 25))
        && request.resource.data.submittedAt is timestamp;
    }

    function validDailyWasteSummary(storeId, selectedDayKey) {
      return request.resource.data.keys().hasOnly([
          'storeId', 'dayKey', 'items', 'sourceEventCount', 'computedAt', 'computedBy'
        ])
        && request.resource.data.storeId == storeId
        && request.resource.data.dayKey == selectedDayKey
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 500
        && request.resource.data.sourceEventCount is int
        && request.resource.data.sourceEventCount >= 0
        && request.resource.data.computedAt is timestamp
        && request.resource.data.computedBy == request.auth.uid;
    }

    function validUsageDay(storeId, selectedDayKey) {
      return request.resource.data.keys().hasOnly([
          'storeId', 'dayKey', 'activeSlotKeys', 'zeroWasteDaypartIds',
          'missedWasteDaypartIds', 'uncertainWasteDaypartIds', 'updatedAt',
          'lastRecordedBy', 'lastDeviceName'
        ])
        && request.resource.data.storeId == storeId
        && request.resource.data.dayKey == selectedDayKey
        && (!request.resource.data.keys().hasAny(['activeSlotKeys'])
          || (request.resource.data.activeSlotKeys is list && request.resource.data.activeSlotKeys.size() <= 80))
        && (!request.resource.data.keys().hasAny(['zeroWasteDaypartIds'])
          || (request.resource.data.zeroWasteDaypartIds is list && request.resource.data.zeroWasteDaypartIds.size() <= 5))
        && (!request.resource.data.keys().hasAny(['missedWasteDaypartIds'])
          || (request.resource.data.missedWasteDaypartIds is list && request.resource.data.missedWasteDaypartIds.size() <= 5))
        && (!request.resource.data.keys().hasAny(['uncertainWasteDaypartIds'])
          || (request.resource.data.uncertainWasteDaypartIds is list && request.resource.data.uncertainWasteDaypartIds.size() <= 5))
        && request.resource.data.lastRecordedBy == request.auth.uid
        && request.resource.data.lastDeviceName is string
        && request.resource.data.updatedAt is timestamp;
    }

    // Each autosave changes one field. Validating that field keeps rule evaluation
    // bounded even when all 60 entries are filled. Final submission preserves values.
    function validPrepEdit(data) {
      let key = data.lastEditedField;
      let value = data.values.get(key, null);
      return (key in [
          'shredded-chicken_lb', 'spicy-chicken_lb', 'romaine_lb', 'lettuce-cabbage_lb',
          'green-leaf_lb', 'tomatoes_lb', 'bacon-crumble_lb', 'kale-batch_lb',
          'apples_lb', 'strawberries_lb', 'blueberries_lb', 'mandarin-oranges_lb',
          'cheddar-blend_lb', 'blue-cheese_lb', 'cobb_eod', 'cobb_left',
          'market_eod', 'market_left', 'southwest_eod', 'southwest_left',
          'side_eod', 'side_left', 'kale-cupped_eod', 'kale-cupped_left',
          'small-fruit_eod', 'small-fruit_left', 'medium-fruit_eod', 'medium-fruit_left',
          'large-fruit_eod', 'large-fruit_left', 'parfait_eod', 'parfait_left',
          'grilled-wrap_eod', 'grilled-wrap_left', 'veggie-wrap_eod', 'veggie-wrap_left',
          'cookies_eod', 'cookies_left', 'brownies_eod', 'brownies_left',
          'bacon-strips_eod', 'bacon-strips_left', 'eggs_eod', 'eggs_left'
        ]
          && (value == null || (value is int && value >= 0 && value <= 10000)))
        || (key in [
          'shredded-chicken_oz', 'spicy-chicken_oz', 'romaine_oz', 'lettuce-cabbage_oz',
          'green-leaf_oz', 'tomatoes_oz', 'bacon-crumble_oz', 'kale-batch_oz',
          'apples_oz', 'strawberries_oz', 'blueberries_oz', 'mandarin-oranges_oz',
          'cheddar-blend_oz', 'blue-cheese_oz'
        ]
          && (value == null || (value is number && value >= 0 && value < 16)))
        || (key in ['tea_eod', 'tea_left']
          && (value == null || (value is number && value >= 0 && value <= 10000)));
    }

    function completePrepValues(values) {
      return values.size() == 60 && !values.values().hasAny([null])
        && values['cobb_left'] <= values['cobb_eod']
        && values['market_left'] <= values['market_eod']
        && values['southwest_left'] <= values['southwest_eod']
        && values['side_left'] <= values['side_eod']
        && values['kale-cupped_left'] <= values['kale-cupped_eod']
        && values['small-fruit_left'] <= values['small-fruit_eod']
        && values['medium-fruit_left'] <= values['medium-fruit_eod']
        && values['large-fruit_left'] <= values['large-fruit_eod']
        && values['parfait_left'] <= values['parfait_eod']
        && values['grilled-wrap_left'] <= values['grilled-wrap_eod']
        && values['veggie-wrap_left'] <= values['veggie-wrap_eod']
        && values['cookies_left'] <= values['cookies_eod']
        && values['brownies_left'] <= values['brownies_eod']
        && values['bacon-strips_left'] <= values['bacon-strips_eod']
        && values['eggs_left'] <= values['eggs_eod']
        && values['tea_left'] <= values['tea_eod'];
    }

    function validSaturdayPrep(storeId, selectedDayKey) {
      let data = request.resource.data;
      return data.keys().hasOnly(['storeId', 'dayKey', 'values', 'updatedAt', 'updatedBy', 'submittedAt', 'lastEditedField'])
        && data.storeId == storeId
        && data.dayKey == selectedDayKey
        && selectedDayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.values is map
        && data.lastEditedField is string
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }

    match /members/{uid} {
      allow read, write: if false;
    }

    function validCooldownTimer(storeId) {
      return request.resource.data.keys().hasOnly([
          'storeId', 'panLabel', 'active', 'startedAt', 'expiresAt', 'lastWasteAt',
          'joinedWasteCount', 'joinedProductIds', 'productQuantities', 'startedBy', 'startedByName'
        ])
        && request.resource.data.storeId == storeId
        && request.resource.data.panLabel is string
        && request.resource.data.active is bool
        && request.resource.data.joinedWasteCount is int
        && request.resource.data.joinedWasteCount >= 0
        && request.resource.data.joinedProductIds is list
        && request.resource.data.productQuantities is map
        && request.resource.data.startedBy is string
        && request.resource.data.startedByName is string;
    }

    match /stores/{storeId} {
      allow read: if belongsToStore(storeId);
      allow write: if false;

      match /settings/{settingsId} {
        allow read: if belongsToStore(storeId);
        allow create, update: if belongsToStore(storeId);
        allow delete: if false;
      }

      match /wasteEvents/{eventId} {
        allow read: if belongsToStore(storeId);
        allow create: if belongsToStore(storeId) && validWasteEvent(storeId);
        allow update: if false;
        allow delete: if belongsToStore(storeId)
          && resource.data.createdBy == request.auth.uid;
      }

      match /discardEvents/{eventId} {
        allow read: if belongsToStore(storeId);
        allow create: if belongsToStore(storeId) && validDiscardEvent(storeId);
        allow update: if false;
        allow delete: if belongsToStore(storeId)
          && resource.data.createdBy == request.auth.uid;
      }

      match /sosEntries/{entryId} {
        allow read: if belongsToStore(storeId);
        allow create, update: if belongsToStore(storeId) && validSosEntry(storeId);
        allow delete: if belongsToStore(storeId);
      }

      match /saturdayPrep/{dayKey} {
        allow read: if belongsToStore(storeId);
        allow create: if belongsToStore(storeId)
          && validSaturdayPrep(storeId, dayKey)
          && request.resource.data.get('submittedAt', null) == null
          && request.resource.data.values.keys().hasOnly([request.resource.data.lastEditedField])
          && validPrepEdit(request.resource.data);
        allow update: if belongsToStore(storeId)
          && validSaturdayPrep(storeId, dayKey)
          && (
            (resource.data.get('submittedAt', null) == null
              && request.resource.data.get('submittedAt', null) == null
              && request.resource.data.values.diff(resource.data.values).affectedKeys().hasOnly([request.resource.data.lastEditedField])
              && validPrepEdit(request.resource.data))
            || (resource.data.get('submittedAt', null) == null
              && request.resource.data.get('submittedAt', null) == request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['submittedAt', 'updatedAt', 'updatedBy'])
              && completePrepValues(request.resource.data.values))
            || (resource.data.get('submittedAt', null) != null
              && request.resource.data.get('submittedAt', null) == null
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['submittedAt', 'updatedAt', 'updatedBy']))
          );
        allow delete: if false;
      }

      match /donationRecords/{dayKey} {
        allow read: if belongsToStore(storeId);
        allow create, update: if belongsToStore(storeId) && validDonationRecord(storeId);
        allow delete: if belongsToStore(storeId);
      }

      match /dailyWasteSummaries/{dayKey} {
        allow read: if belongsToStore(storeId);
        allow create, update: if belongsToStore(storeId)
          && validDailyWasteSummary(storeId, dayKey);
        allow delete: if false;
      }

      match /usageDays/{dayKey} {
        allow read: if belongsToStore(storeId);
        allow create, update: if belongsToStore(storeId)
          && validUsageDay(storeId, dayKey);
        allow delete: if false;
      }

      match /cooldownTimers/{panId} {
        allow read: if belongsToStore(storeId);
        allow create, update: if belongsToStore(storeId) && validCooldownTimer(storeId);
        allow delete: if false;
      }

      match /exportDemoWaste/{eventId} {
        allow read, create, update, delete: if belongsToStore(storeId);
      }

      match /exportDemoDonations/{recordId} {
        allow read, create, update, delete: if belongsToStore(storeId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
